# Copy to .env and edit locally. Do not commit .env.

APP_ENVIRONMENT=development

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=medical_ai
MYSQL_USER=medical_ai
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root

QUERY_DEFAULT_LIMIT=100
QUERY_MAX_LIMIT=1000
QUERY_MAX_DISTINCT_VALUES=200
QUERY_TIMEOUT_MS=30000
PRIVACY_MIN_GROUP_SIZE=5

API_MAX_BODY_BYTES=2000000
API_MAX_QUESTION_CHARS=2000

# Browser authentication. Keep secure cookies enabled outside local HTTP tests.
AUTH_SESSION_COOKIE_NAME=medical_ai_session
AUTH_SESSION_COOKIE_SECURE=true
AUTH_SESSION_COOKIE_SAMESITE=Lax
AUTH_SESSION_IDLE_MINUTES=30
AUTH_SESSION_ABSOLUTE_HOURS=12
AUTH_SESSION_TOUCH_MINUTES=5
AUTH_CSRF_COOKIE_NAME=medical_ai_csrf
AUTH_CSRF_HEADER_NAME=X-CSRF-Token
AUTH_ENFORCEMENT_ENABLED=false

# Shared login protection. Production must enable this and provide a unique,
# randomly generated secret of at least 32 UTF-8 bytes.
RATE_LIMIT_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
RATE_LIMIT_KEY_SECRET=replace_with_at_least_32_random_bytes
LOGIN_RATE_LIMIT_IP_ATTEMPTS=20
LOGIN_RATE_LIMIT_ACCOUNT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=3001
MCP_ALLOW_UNSCOPED_TOOLS=true

LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=change_me
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_SECONDS=0.5

GUNICORN_BIND=127.0.0.1:8000
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT_SECONDS=150
GUNICORN_GRACEFUL_TIMEOUT_SECONDS=30
GUNICORN_KEEPALIVE_SECONDS=5
